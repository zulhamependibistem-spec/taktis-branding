# Supabase (wajib)
SUPABASE_PROJECT_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Session (wajib, string bebas & rahasia, buat random yang panjang)
SESSION_SECRET=ganti-ini-dengan-string-random-panjang

# Direct Postgres (opsional, hanya untuk script import lokal scripts/run_import.mjs)
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres